# ==============================================================================
# STULZ ESPAÑA — SGP-F CONFIGURACIÓN DE ENTORNO LOCAL (AIR-GAP)
# ==============================================================================
# NUNCA USAR DIRECCIONES IP PÚBLICAS NI ENDPOINTS EN LA NUBE.
# ESTE ARCHIVO ES EXCLUSIVAMENTE LOCAL EN LA INTRANET DE PLANTA.
# ==============================================================================

# Entorno
NODE_ENV=production
PORT=4000
HOST=127.0.0.1

# Seguridad Industrial & Blindaje
CORS_ORIGIN=http://localhost:5173,http://localhost:4000,http://127.0.0.1:5173
JWT_SECRET=CAMBIAR_EN_PRODUCCION_POR_CADENA_ALEATORIA_64_CHARS_LOCAL
SESSION_TIMEOUT_MINUTES=480

# Base de Datos SQL Server Local (Sin salida exterior)
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=SGP_FABRICA_STULZ
SQL_SERVER_USER=sa
SQL_SERVER_PASSWORD=DefinirPasswordSeguroLocalEnPlanta
SQL_SERVER_ENCRYPT=false
SQL_SERVER_TRUST_SERVER_CERTIFICATE=true

# Python Engine (FastAPI Local IPC)
PYTHON_API_URL=http://127.0.0.1:8000
PYTHON_API_SECRET=token_interno_ipc_local_fastapi_node

# Power BI Gateway Local
POWERBI_DIRECTQUERY_ENABLED=true
